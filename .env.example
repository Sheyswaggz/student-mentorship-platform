# =============================================================================
# STUDENT MENTORSHIP PLATFORM - ENVIRONMENT VARIABLES
# =============================================================================
# This file serves as a template for required environment variables.
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control - it contains sensitive information.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# Determines the runtime environment of the application
# Options: development | production | test
# Default: development
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?[options]
# Example: postgresql://postgres:password@localhost:5432/mentorship_db?schema=public
# Required: Yes
DATABASE_URL=postgresql://username:password@localhost:5432/student_mentorship_platform

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
# Redis connection string for caching and session management
# Format: redis://[user]:[password]@[host]:[port]/[database]
# Example: redis://:password@localhost:6379/0
# Required: Yes (for production), Optional (for development with fallback)
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# NEXTAUTH CONFIGURATION
# -----------------------------------------------------------------------------
# NextAuth.js secret for JWT encryption and session management
# Generate with: openssl rand -base64 32
# Required: Yes (especially in production)
# Security: Must be a strong, random string (minimum 32 characters)
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production-min-32-chars

# NextAuth.js canonical URL for the application
# Used for OAuth callbacks and email verification links
# Format: http://[host]:[port] or https://[domain]
# Example (development): http://localhost:3000
# Example (production): https://mentorship.example.com
# Required: Yes
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OPTIONAL: ADDITIONAL CONFIGURATION
# -----------------------------------------------------------------------------

# Application Port (if not using default 3000)
# PORT=3000

# Database Connection Pool Settings
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Redis Connection Pool Settings
# REDIS_POOL_MIN=2
# REDIS_POOL_MAX=10

# Session Configuration
# SESSION_MAX_AGE=2592000
# SESSION_UPDATE_AGE=86400

# JWT Token Expiration (in seconds)
# JWT_ACCESS_TOKEN_EXPIRY=900
# JWT_REFRESH_TOKEN_EXPIRY=604800

# Email Service Configuration (if implementing email features)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Student Mentorship Platform <noreply@example.com>

# File Upload Configuration
# MAX_FILE_SIZE=5242880
# UPLOAD_DIR=./uploads

# Logging Configuration
# LOG_LEVEL=info
# LOG_FORMAT=json

# CORS Configuration (for API endpoints)
# CORS_ORIGIN=http://localhost:3000
# CORS_CREDENTIALS=true

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
# ENABLE_REGISTRATION=true
# ENABLE_EMAIL_VERIFICATION=false
# ENABLE_TWO_FACTOR_AUTH=false

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Never commit .env files to version control
# 2. Use strong, unique passwords for all services
# 3. Rotate secrets regularly in production
# 4. Use environment-specific values (different for dev/staging/prod)
# 5. Consider using a secrets management service in production
# 6. Ensure DATABASE_URL and REDIS_URL use secure connections in production
# 7. Keep NEXTAUTH_SECRET cryptographically secure and private
# =============================================================================